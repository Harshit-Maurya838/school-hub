// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ACCOUNTANT
  TEACHER
  PARENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  PROMOTED
  COMPLETED
  DROPPED
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum RegistrationStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RESIGNED
}

enum AssignmentStatus {
  ACTIVE
  REPLACED
  COMPLETED
  CANCELLED
}

model School {
  id               String               @id @default(cuid())
  name             String
  code             String               @unique
  slug             String               @unique
  isActive         Boolean              @default(true)
  status           SchoolStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  users            User[]
  auditLogs        AuditLog[]
  academicYears    AcademicYear[]
  classes          Class[]
  sections         Section[]
  subjects         Subject[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  enrollments      Enrollment[]
  invitations      Invitation[]
  registrations    SchoolRegistration[]
  teacherProfiles  TeacherProfile[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  attendanceRegisters       AttendanceRegister[]
  attendanceCorrections     AttendanceCorrection[]
  exams                     Exam[]
  examClasses               ExamClass[]
  examSubjectConfigs        ExamSubjectConfig[]
  examSectionSubjects       ExamSectionSubject[]
  studentExamMarks          StudentExamMark[]
  examMarkCorrections       ExamMarkCorrection[]

  @@map("schools")
}

model User {
  id                    String               @id @default(cuid())
  schoolId              String?
  name                  String
  email                 String?              @unique
  phone                 String?
  passwordHash          String?
  role                  Role
  isActive              Boolean              @default(true)
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  school                School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  auditLogs             AuditLog[]
  guardians             Guardian[]
  student               Student?
  teacherProfile        TeacherProfile?
  createdInvitations    Invitation[]         @relation("CreatedInvitations")
  reviewedRegistrations SchoolRegistration[] @relation("ReviewedRegistrations")
  submittedAttendanceRegisters AttendanceRegister[] @relation("SubmittedRegisters")
  createdAttendanceRegisters   AttendanceRegister[] @relation("CreatedRegisters")
  updatedAttendanceRegisters   AttendanceRegister[] @relation("UpdatedRegisters")
  attendanceCorrections        AttendanceCorrection[]
  createdExams                 Exam[]                 @relation("CreatedExams")
  updatedExams                 Exam[]                 @relation("UpdatedExams")
  publishedExams               Exam[]                 @relation("PublishedExams")
  submittedExamSectionSubjects ExamSectionSubject[]   @relation("SubmittedExamSectionSubjects")
  reviewedExamSectionSubjects  ExamSectionSubject[]   @relation("ReviewedExamSectionSubjects")
  createdStudentExamMarks      StudentExamMark[]      @relation("CreatedStudentExamMarks")
  updatedStudentExamMarks      StudentExamMark[]      @relation("UpdatedStudentExamMarks")
  correctedExamMarks           ExamMarkCorrection[]   @relation("CorrectedExamMarks")

  @@index([schoolId])
  @@index([role])
  @@index([phone])
  @@index([schoolId, role])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AcademicYear {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  attendanceRegisters       AttendanceRegister[]
  exams                     Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Class {
  id           String       @id @default(cuid())
  schoolId     String
  name         String
  numericOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections     Section[]
  subjects     Subject[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  examClasses               ExamClass[]
  examSubjectConfigs        ExamSubjectConfig[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id          String       @id @default(cuid())
  schoolId    String
  classId     String
  name        String
  capacity    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  attendanceRegisters       AttendanceRegister[]
  examSectionSubjects       ExamSectionSubject[]
  studentExamMarks          StudentExamMark[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String?
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherAssignments SubjectTeacherAssignment[]
  examSubjectConfigs ExamSubjectConfig[]
  examSectionSubjects ExamSectionSubject[]
  studentExamMarks   StudentExamMark[]
  examMarkCorrections ExamMarkCorrection[]

  @@index([schoolId])
  @@index([classId])
  @@map("subjects")
}

model Student {
  id              String            @id @default(cuid())
  schoolId        String
  admissionNumber String
  name            String
  dob             DateTime
  gender          Gender
  apaarId         String?
  userId          String?           @unique
  isActive        Boolean           @default(true)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians       StudentGuardian[]
  enrollments     Enrollment[]
  invitations     Invitation[]
  attendanceRecords AttendanceRecord[]
  examMarks       StudentExamMark[]
  examMarkCorrections ExamMarkCorrection[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, deletedAt])
  @@index([schoolId, name])
  @@map("students")
}

model Guardian {
  id          String            @id @default(cuid())
  schoolId    String
  name        String
  phone       String
  email       String?
  occupation  String?
  address     String?
  userId      String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students    StudentGuardian[]
  invitations Invitation[]

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id           String               @id @default(cuid())
  schoolId     String
  studentId    String
  guardianId   String
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Enrollment {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  sectionId      String
  academicYearId String
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  examMarks      StudentExamMark[]

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([sectionId, academicYearId])
  @@index([studentId])
  @@map("enrollments")
}

model Invitation {
  id          String           @id @default(cuid())
  schoolId    String
  email       String
  role        Role
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  guardianId  String?
  studentId   String?
  metadata    Json?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedBy   User?            @relation("CreatedInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  guardian    Guardian?        @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  student     Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([email])
  @@index([schoolId, role])
  @@index([status])
  @@map("invitations")
}

model SchoolRegistration {
  id                    String             @id @default(cuid())
  schoolName            String
  schoolCode            String             @unique
  desiredSlug           String             @unique
  adminName             String
  adminEmail            String             @unique
  adminPhone            String?
  status                RegistrationStatus @default(PENDING_VERIFICATION)
  verificationTokenHash String?            @unique
  emailVerifiedAt       DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?
  schoolId              String?            @unique
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  reviewedBy            User?              @relation("ReviewedRegistrations", fields: [reviewedById], references: [id], onDelete: SetNull)
  school                School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([adminEmail])
  @@map("school_registrations")
}

model TeacherProfile {
  id                  String                     @id @default(cuid())
  schoolId            String
  userId              String                     @unique
  employeeId          String?
  qualification       String?
  specialization      String?
  designation         String?
  department          String?
  joiningDate         DateTime?
  status              EmploymentStatus           @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  school              School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAssignments    ClassTeacherAssignment[]
  subjectAssignments  SubjectTeacherAssignment[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("teacher_profiles")
}

model ClassTeacherAssignment {
  id               String           @id @default(cuid())
  schoolId         String
  academicYearId   String
  classId          String
  sectionId        String
  teacherProfileId String
  isPrimary        Boolean          @default(true)
  status           AssignmentStatus @default(ACTIVE)
  startDate        DateTime         @default(now())
  endDate          DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId, sectionId, status])
  @@index([teacherProfileId, academicYearId])
  @@map("class_teacher_assignments")
}

model SubjectTeacherAssignment {
  id               String           @id @default(cuid())
  schoolId         String
  academicYearId   String
  classId          String
  sectionId        String
  subjectId        String
  teacherProfileId String
  status           AssignmentStatus @default(ACTIVE)
  startDate        DateTime         @default(now())
  endDate          DateTime?
  periodsPerWeek   Int?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId, sectionId, subjectId])
  @@index([teacherProfileId, academicYearId])
  @@index([academicYearId, status])
  @@map("subject_teacher_assignments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RegisterStatus {
  DRAFT
  SUBMITTED
}

model AttendanceRegister {
  id             String             @id @default(cuid())
  schoolId       String
  academicYearId String
  sectionId      String
  date           DateTime
  status         RegisterStatus     @default(DRAFT)
  submittedAt    DateTime?
  submittedById  String?
  createdById    String?
  updatedById    String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section        Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  submittedBy    User?              @relation("SubmittedRegisters", fields: [submittedById], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("CreatedRegisters", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?              @relation("UpdatedRegisters", fields: [updatedById], references: [id], onDelete: SetNull)
  records        AttendanceRecord[]
  corrections    AttendanceCorrection[]

  @@unique([schoolId, academicYearId, sectionId, date])
  @@index([schoolId])
  @@index([sectionId, date])
  @@index([academicYearId, sectionId])
  @@map("attendance_registers")
}

model AttendanceRecord {
  id           String             @id @default(cuid())
  registerId   String
  studentId    String
  enrollmentId String
  status       AttendanceStatus
  remarks      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  register     AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  corrections  AttendanceCorrection[]

  @@unique([registerId, studentId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([registerId, status])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id             String             @id @default(cuid())
  registerId     String
  recordId       String?
  schoolId       String
  correctedById  String
  reason         String
  previousStatus AttendanceStatus?
  newStatus      AttendanceStatus?
  details        Json?
  createdAt      DateTime           @default(now())

  register       AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  record         AttendanceRecord?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  correctedBy    User               @relation(fields: [correctedById], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([registerId])
  @@index([recordId])
  @@index([correctedById])
  @@map("attendance_corrections")
}

enum ExamType {
  UNIT_TEST
  MID_TERM
  FINAL
  QUARTERLY
  PRACTICAL
  OTHER
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  MARKS_ENTRY
  UNDER_REVIEW
  PUBLISHED
  CANCELLED
}

enum ExamMarksSubmissionStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  PUBLISHED
}

model Exam {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  type           ExamType
  description    String?
  startDate      DateTime
  endDate        DateTime
  status         ExamStatus   @default(DRAFT)
  publishedAt    DateTime?
  publishedById  String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  publishedBy    User?        @relation("PublishedExams", fields: [publishedById], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("CreatedExams", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?        @relation("UpdatedExams", fields: [updatedById], references: [id], onDelete: SetNull)

  classes        ExamClass[]
  subjectConfigs ExamSubjectConfig[]
  sectionSubjects ExamSectionSubject[]
  studentMarks   StudentExamMark[]
  corrections    ExamMarkCorrection[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([status])
  @@map("exams")
}

model ExamClass {
  id        String   @id @default(cuid())
  schoolId  String
  examId    String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([examId, classId])
  @@index([schoolId])
  @@index([classId])
  @@map("exam_classes")
}

model ExamSubjectConfig {
  id        String   @id @default(cuid())
  schoolId  String
  examId    String
  classId   String
  subjectId String
  maxMarks  Float
  passMarks Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, classId, subjectId])
  @@index([schoolId])
  @@index([examId])
  @@index([subjectId])
  @@map("exam_subject_configs")
}

model ExamSectionSubject {
  id            String                    @id @default(cuid())
  schoolId      String
  examId        String
  sectionId     String
  subjectId     String
  status        ExamMarksSubmissionStatus @default(NOT_STARTED)
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNotes   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  school        School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam          Exam                      @relation(fields: [examId], references: [id], onDelete: Cascade)
  section       Section                   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject       Subject                   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submittedBy   User?                     @relation("SubmittedExamSectionSubjects", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy    User?                     @relation("ReviewedExamSectionSubjects", fields: [reviewedById], references: [id], onDelete: SetNull)

  studentMarks  StudentExamMark[]

  @@unique([examId, sectionId, subjectId])
  @@index([schoolId])
  @@index([examId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([status])
  @@map("exam_section_subjects")
}

model StudentExamMark {
  id                   String              @id @default(cuid())
  schoolId             String
  examId               String
  examSectionSubjectId String?
  studentId            String
  enrollmentId         String
  sectionId            String
  subjectId            String
  marksObtained        Float?
  isAbsent             Boolean             @default(false)
  isExempt             Boolean             @default(false)
  remarks              String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam                 Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSectionSubject   ExamSectionSubject? @relation(fields: [examSectionSubjectId], references: [id], onDelete: SetNull)
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment           Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  section              Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject              Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy            User?               @relation("CreatedStudentExamMarks", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?               @relation("UpdatedStudentExamMarks", fields: [updatedById], references: [id], onDelete: SetNull)

  corrections          ExamMarkCorrection[]

  @@unique([examId, studentId, subjectId])
  @@index([schoolId])
  @@index([examId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("student_exam_marks")
}

model ExamMarkCorrection {
  id             String          @id @default(cuid())
  schoolId       String
  examId         String
  studentMarkId  String
  studentId      String
  subjectId      String
  correctedById  String
  previousMarks  Float?
  newMarks       Float?
  previousAbsent Boolean         @default(false)
  newAbsent      Boolean         @default(false)
  reason         String
  details        Json?
  createdAt      DateTime        @default(now())

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentMark    StudentExamMark @relation(fields: [studentMarkId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  correctedBy    User            @relation("CorrectedExamMarks", fields: [correctedById], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([examId])
  @@index([studentMarkId])
  @@index([studentId])
  @@index([correctedById])
  @@map("exam_mark_corrections")
}




