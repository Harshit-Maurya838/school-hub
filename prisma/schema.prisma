// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ACCOUNTANT
  TEACHER
  PARENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  PROMOTED
  COMPLETED
  DROPPED
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum RegistrationStatus {
  PENDING_VERIFICATION
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RESIGNED
}

enum AssignmentStatus {
  ACTIVE
  REPLACED
  COMPLETED
  CANCELLED
}

model School {
  id               String               @id @default(cuid())
  name             String
  code             String               @unique
  slug             String               @unique
  isActive         Boolean              @default(true)
  status           SchoolStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  users            User[]
  auditLogs        AuditLog[]
  academicYears    AcademicYear[]
  classes          Class[]
  sections         Section[]
  subjects         Subject[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  enrollments      Enrollment[]
  invitations      Invitation[]
  registrations    SchoolRegistration[]
  teacherProfiles  TeacherProfile[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]

  @@map("schools")
}

model User {
  id                    String               @id @default(cuid())
  schoolId              String?
  name                  String
  email                 String?              @unique
  phone                 String?
  passwordHash          String?
  role                  Role
  isActive              Boolean              @default(true)
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  school                School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  auditLogs             AuditLog[]
  guardians             Guardian[]
  student               Student?
  teacherProfile        TeacherProfile?
  createdInvitations    Invitation[]         @relation("CreatedInvitations")
  reviewedRegistrations SchoolRegistration[] @relation("ReviewedRegistrations")

  @@index([schoolId])
  @@index([role])
  @@index([phone])
  @@index([schoolId, role])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AcademicYear {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Class {
  id           String       @id @default(cuid())
  schoolId     String
  name         String
  numericOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections     Section[]
  subjects     Subject[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id          String       @id @default(cuid())
  schoolId    String
  classId     String
  name        String
  capacity    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String?
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherAssignments SubjectTeacherAssignment[]

  @@index([schoolId])
  @@index([classId])
  @@map("subjects")
}

model Student {
  id              String            @id @default(cuid())
  schoolId        String
  admissionNumber String
  name            String
  dob             DateTime
  gender          Gender
  apaarId         String?
  userId          String?           @unique
  isActive        Boolean           @default(true)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians       StudentGuardian[]
  enrollments     Enrollment[]
  invitations     Invitation[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, deletedAt])
  @@index([schoolId, name])
  @@map("students")
}

model Guardian {
  id          String            @id @default(cuid())
  schoolId    String
  name        String
  phone       String
  email       String?
  occupation  String?
  address     String?
  userId      String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students    StudentGuardian[]
  invitations Invitation[]

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id           String               @id @default(cuid())
  schoolId     String
  studentId    String
  guardianId   String
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Enrollment {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  sectionId      String
  academicYearId String
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([sectionId, academicYearId])
  @@index([studentId])
  @@map("enrollments")
}

model Invitation {
  id          String           @id @default(cuid())
  schoolId    String
  email       String
  role        Role
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  guardianId  String?
  studentId   String?
  metadata    Json?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedBy   User?            @relation("CreatedInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  guardian    Guardian?        @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  student     Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([email])
  @@index([schoolId, role])
  @@index([status])
  @@map("invitations")
}

model SchoolRegistration {
  id                    String             @id @default(cuid())
  schoolName            String
  schoolCode            String             @unique
  desiredSlug           String             @unique
  adminName             String
  adminEmail            String             @unique
  adminPhone            String?
  status                RegistrationStatus @default(PENDING_VERIFICATION)
  verificationTokenHash String?            @unique
  emailVerifiedAt       DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?
  schoolId              String?            @unique
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  reviewedBy            User?              @relation("ReviewedRegistrations", fields: [reviewedById], references: [id], onDelete: SetNull)
  school                School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([adminEmail])
  @@map("school_registrations")
}

model TeacherProfile {
  id                  String                     @id @default(cuid())
  schoolId            String
  userId              String                     @unique
  employeeId          String?
  qualification       String?
  specialization      String?
  designation         String?
  department          String?
  joiningDate         DateTime?
  status              EmploymentStatus           @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  school              School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAssignments    ClassTeacherAssignment[]
  subjectAssignments  SubjectTeacherAssignment[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("teacher_profiles")
}

model ClassTeacherAssignment {
  id               String           @id @default(cuid())
  schoolId         String
  academicYearId   String
  classId          String
  sectionId        String
  teacherProfileId String
  isPrimary        Boolean          @default(true)
  status           AssignmentStatus @default(ACTIVE)
  startDate        DateTime         @default(now())
  endDate          DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId, sectionId, status])
  @@index([teacherProfileId, academicYearId])
  @@map("class_teacher_assignments")
}

model SubjectTeacherAssignment {
  id               String           @id @default(cuid())
  schoolId         String
  academicYearId   String
  classId          String
  sectionId        String
  subjectId        String
  teacherProfileId String
  status           AssignmentStatus @default(ACTIVE)
  startDate        DateTime         @default(now())
  endDate          DateTime?
  periodsPerWeek   Int?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId, sectionId, subjectId])
  @@index([teacherProfileId, academicYearId])
  @@index([academicYearId, status])
  @@map("subject_teacher_assignments")
}


